{
	"name": "paperhanger",
	"module": "src/index.ts",
	"type": "module",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --hot src/index.ts",
		"test": "bun test src agent-host/src",
		"test:integration": "bun test tests/integration",
		"typecheck": "tsgo --noEmit -p tsconfig.json",
