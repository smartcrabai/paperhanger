		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/bun": "latest",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"oxlint": "1.89.0",
		"testcontainers": "12.2.1"
	},
	"peerDependencies": {
		"typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
	},
	"dependencies": {
		"@flue/sdk": "2.3.0",
